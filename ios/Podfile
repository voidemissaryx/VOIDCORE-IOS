// Podfile
//
// CocoaPods dependencies for VOIDCORE-iOS. The Packet Tunnel Extension needs
// its own podfile target so it gets the NetworkExtension framework link.
// `flutter build ios` runs `pod install` automatically; this file is here for
// standalone xcodebuild and for the GitHub Actions workflow.

platform :ios, '16.0'
use_frameworks!

# When Flutter drives the build, it injects its own pod dependencies via the
# Generated.xcconfig. The targets below declare only the native pods we add on
# top: none right now (the Xray core ships as an .xcframework linked directly
# in the project, not through CocoaPods).

target 'Runner' do
  # The Flutter plugins are added here by `flutter pub get` -> pod install.
end

target 'PacketTunnel' do
  # The extension only needs the NetworkExtension system framework, already
  # linked through the SDK. No third-party pods.
end
