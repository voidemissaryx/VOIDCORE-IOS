# Project
!/.gitignore
!/README.md
!/RELEASE_NOTES.md
!/LICENSE
!/pubspec.yaml
!/pubspec.lock
!/analysis_options.yaml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.yml
!/.github/workflows/*.yml

# Icon sources (the launcher, status bar and splash icons are made from these)
!/images/**

# App
!/lib/**
!/test/**
!/scripts/**
!/assets/fonts/**
!/assets/icons/**
!/assets/scanner/**
!/assets/dns/
!/assets/dns/**
!/scanner/**
!/networking/**

# iOS
!/ios/Runner.xcodeproj/**
!/ios/Runner.xcworkspace/**
!/ios/Runner/**
!/ios/PacketTunnel/**
!/ios/Flutter/**
!/ios/Podfile
!/ios/Frameworks/README.md
# Built Xray.xcframework is not checked in (too large, platform-specific).
/ios/Frameworks/Xray.xcframework
# CocoaPods and Flutter build outputs
/ios/Pods/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Flutter/.symlinks/

# Android
!/android/build.gradle.kts
!/android/settings.gradle.kts
!/android/gradle.properties
!/android/gradle/wrapper/gradle-wrapper.properties
!/android/app/build.gradle.kts
!/android/app/src/main/AndroidManifest.xml
!/android/app/src/debug/AndroidManifest.xml
!/android/app/src/profile/AndroidManifest.xml
!/android/app/src/main/kotlin/**
!/android/app/src/test/kotlin/**
!/android/app/src/main/res/**
!/android/app/src/main/assets/psiphon_config.json

# Native helpers
!/psiphon/**
!/xray/*.go
!/xray/go.mod
!/xray/go.sum

# Worker
!/worker/worker.js
!/worker/package.json
